<Window x:Class="MeteostraSimApk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeteOstraSimApk" Height="750" Width="900" Background="White">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <Image Source="/logo.png"
                   MaxWidth="400" 
                   MaxHeight="100" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Left" 
                   Margin="0,0,0,10"/>
            <TextBlock Text="Digitální dvojče pro generování dat a testování chybových stavů. v98" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="DarkGray"/>

            <GroupBox Header="1. Výstup dat (Komunikace a Logování)" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Název zařízení (ID):" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtDeviceId" Text="METEO01" Width="150" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,10"/>

                    <CheckBox x:Name="ChkUseComPort" Content="Povolit odesílání na sériový (COM) port" IsChecked="True" FontWeight="Bold" Margin="0,0,0,5" Click="OutputMethod_Changed"/>
                    <Grid x:Name="GridComSettings" Margin="20,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Port:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtComPort" Grid.Column="1" Text="COM1" Margin="5,0,10,0"/>
                        <TextBlock Text="BaudRate:" Grid.Column="2" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbBaudRate" Grid.Column="3" Margin="5,0,0,0" SelectedIndex="0">
                            <ComboBoxItem Content="9600"/>
                            <ComboBoxItem Content="19200"/>
                            <ComboBoxItem Content="38400"/>
                            <ComboBoxItem Content="115200"/>
                        </ComboBox>
                    </Grid>

                    <Separator Margin="0,5,0,10"/>

                    <CheckBox x:Name="ChkUseFile" Content="Povolit zálohování do souboru" IsChecked="False" FontWeight="Bold" Margin="0,0,0,5" Click="OutputMethod_Changed"/>
                    <StackPanel x:Name="PanelFileSettings" Margin="20,0,0,5" IsEnabled="False">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <RadioButton x:Name="RbCsv" Content="CSV" IsChecked="True" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RbJson" Content="JSON Lines" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RbTxt" Content="TXT Stream"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFilePath" IsReadOnly="True" Text="Vyberte cestu k souboru..."/>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="..." Width="30" Margin="5,0,0,0" Click="BtnBrowse_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="2. Scénáře generování (Denní cyklus)" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <RadioButton x:Name="RbScenManual" Content="Manuální režim (Slidery řídí data napřímo)" IsChecked="True" Checked="Scenario_Changed"/>
                    <RadioButton x:Name="RbScenSummer" Content="Letní den (Teplota 15 → 34°C)" Checked="Scenario_Changed"/>
                    <RadioButton x:Name="RbScenStorm" Content="Podzimní bouřka (Večerní propad tlaku a teploty)" Checked="Scenario_Changed"/>
                    <RadioButton x:Name="RbScenInversion" Content="Inverze/Smog (Večerní nárůst CO2 na 1200 PPM)" Checked="Scenario_Changed"/>
                    <RadioButton x:Name="RbScenFreeze" Content="Mrazivá noc (-5°C → -20°C)" Checked="Scenario_Changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox x:Name="GrpManual" Header="Manuální ovládání veličin" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <TextBlock Text="{Binding ElementName=SldTemp, Path=Value, StringFormat='Teplota: {0:F1} °C'}"/>
                    <Slider x:Name="SldTemp" Minimum="-40" Maximum="85" Value="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ManualSlider_ValueChanged"/>

                    <TextBlock Text="{Binding ElementName=SldHum, Path=Value, StringFormat='Vlhkost: {0:F0} %'}" Margin="0,5,0,0"/>
                    <Slider x:Name="SldHum" Minimum="0" Maximum="100" Value="50" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ManualSlider_ValueChanged"/>

                    <TextBlock Text="{Binding ElementName=SldPress, Path=Value, StringFormat='Tlak: {0:F0} hPa'}" Margin="0,5,0,0"/>
                    <Slider x:Name="SldPress" Minimum="300" Maximum="1100" Value="1013" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ManualSlider_ValueChanged"/>

                    <TextBlock Text="{Binding ElementName=SldCo2, Path=Value, StringFormat='CO2: {0:F0} PPM'}" Margin="0,5,0,0"/>
                    <Slider x:Name="SldCo2" Minimum="400" Maximum="5000" Value="400" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="ManualSlider_ValueChanged"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10,0,0,0">
            <GroupBox Header="3. Chaos Engine (Vstřikování chyb)" Margin="0,0,0,10" Padding="5" BorderBrush="DarkRed">
                <StackPanel>
                    <TextBlock Text="{Binding ElementName=SldNoise, Path=Value, StringFormat='Šance na šum: {0:F0} %'}"/>
                    <Slider x:Name="SldNoise" Minimum="0" Maximum="100" Value="0" ValueChanged="ChaosSlider_ValueChanged"/>

                    <TextBlock Text="{Binding ElementName=SldOutlier, Path=Value, StringFormat='Šance na Hrot (Outlier): {0:F0} %'}" Margin="0,5,0,0"/>
                    <Slider x:Name="SldOutlier" Minimum="0" Maximum="100" Value="0" ValueChanged="ChaosSlider_ValueChanged"/>

                    <TextBlock Text="{Binding ElementName=SldNull, Path=Value, StringFormat='Šance na Výpadek (Null): {0:F0} %'}" Margin="0,5,0,0"/>
                    <Slider x:Name="SldNull" Minimum="0" Maximum="100" Value="0" ValueChanged="ChaosSlider_ValueChanged"/>

                    <TextBlock Text="{Binding ElementName=SldChecksum, Path=Value, StringFormat='Šance na špatný Checksum: {0:F0} %'}" Margin="0,5,0,0"/>
                    <Slider x:Name="SldChecksum" Minimum="0" Maximum="100" Value="0" ValueChanged="ChaosSlider_ValueChanged"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="4. Běh simulace" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <TextBlock Text="{Binding ElementName=SldSpeed, Path=Value, StringFormat='Rychlost generování (Interval): {0:F0} ms'}" FontWeight="SemiBold"/>
                    <Slider x:Name="SldSpeed" Minimum="10" Maximum="60000" Value="1000" TickFrequency="100" SmallChange="10" LargeChange="1000" Margin="0,5,0,15" ValueChanged="SldSpeed_ValueChanged"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnStartStop" Content="SPUSTIT SIMULACI" Background="LightGreen" Height="40" FontWeight="Bold" Margin="0,0,5,0" Click="BtnStartStop_Click"/>
                        <Button x:Name="BtnReset" Content="RESET" Background="LightGray" Height="40" Grid.Column="1" Margin="5,0,0,0" Click="BtnReset_Click"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Traffic Log &amp; Statistiky" Margin="0,0,0,0" Padding="5" Height="240">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock x:Name="LblTime" Text="Čas běhu: 00:00:00" FontWeight="Bold" Margin="0,0,15,0"/>
                        <TextBlock x:Name="LblErrorStats" Text="Vygenerováno chyb: 0" Foreground="Red" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBox x:Name="TxtTrafficLog" Height="180" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas" Background="#FAFAFA"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>